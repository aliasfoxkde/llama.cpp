#!/usr/bin/env python3
"""
llama-proxy: Reverse proxy for llama-server with model switching support.
- Serves static docs at /
- Model endpoints: /models, /model
- Proxies all other requests to llama-server on 8080
"""

import subprocess
import json
import sys
from http.server import HTTPServer, BaseHTTPRequestHandler
import threading
import time
import os

LLAMA_HOST = "localhost"
LLAMA_PORT = 8080
PROXY_PORT = 8082
DOCS_PATH = "/home/mkinney/.llama-server/docs"

MODEL_ALIASES = {
    "Ultra": {
        "path": "/home/mkinney/Models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-IQ3_XXS.gguf",
        "slug": "ultra",
        "display_name": "Qwen3.8-27B Ultra",
        "description": "Qwen3 8B Instruct model, IQ3_XXS quantization",
    },
    "Turbo": {
        "path": "/home/mkinney/Models/JZC973/Qwen3.6-35B-REAP-MTP-UD-GGUF-Collection/Qwen3.6-35B-A3B-UD-Q3_K_M-REAP.gguf",
        "slug": "turbo",
        "display_name": "Qwen3.6-35B Turbo",
        "description": "Qwen3 35B REAP-MTP model, Q3_K_M quantization",
    },
    "Lite": {
        "path": "/home/mkinney/Models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-IQ3_XXS.gguf",
        "slug": "lite",
        "display_name": "Qwen3.8-27B Lite",
        "description": "Same as Ultra, configured for lower resource usage",
    },
}

# Map Codex model names to internal aliases
MODEL_SLUGS = {
    "ultra": "Ultra",
    "turbo": "Turbo",
    "lite": "Lite",
    "qwen3.8-27b": "Ultra",
    "qwen3.6-35b": "Turbo",
}

current_model = os.environ.get("CURRENT_MODEL", "Ultra")
model_lock = threading.Lock()
server_process = None


def start_llama_server(model_path):
    """Start or restart llama-server with the given model."""
    global server_process

    # Check if llama-server is already running on our port
    import urllib.request
    try:
        urllib.request.urlopen(f"http://{LLAMA_HOST}:{LLAMA_PORT}/health", timeout=1)
        print(f"llama-server already running on port {LLAMA_PORT}")
        return True
    except:
        pass

    # Not running, start it
    subprocess.run(["pkill", "-f", "llama-server"], stderr=subprocess.DEVNULL)
    time.sleep(2)

    cmd = [
        "/home/mkinney/Repos/llama.cpp/build-cuda-new/bin/llama-server",
        "-m", model_path,
        "-c", "131072",
        "-tb", "256",
        "-ctk", "q4_0",
        "-ctv", "q4_0",
        "-ngl", "99",
        "-t", "16",
        "-np", "4",
        "-fa", "on",
        "--sleep-idle-seconds", "300",
        "--host", "0.0.0.0",
        "--port", str(LLAMA_PORT),
    ]

    server_process = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    import urllib.request
    for _ in range(60):
        try:
            urllib.request.urlopen(f"http://{LLAMA_HOST}:{LLAMA_PORT}/health", timeout=1)
            return True
        except:
            time.sleep(0.5)
    return False


def switch_model(alias):
    """Switch to a different model."""
    global current_model

    if alias not in MODEL_ALIASES:
        return False, f"Unknown model: {alias}. Available: {', '.join(MODEL_ALIASES.keys())}"

    model_info = MODEL_ALIASES[alias]
    model_path = model_info["path"]
    if not os.path.exists(model_path):
        return False, f"Model file not found: {model_path}"

    current_model = alias
    success = start_llama_server(model_path)
    if success:
        return True, f"Switched to {alias}"
    return False, "Failed to start server"


def resolve_model(model_name):
    """Resolve a model name (Ultra/Turbo/Lite or slug) to internal alias."""
    if model_name in MODEL_ALIASES:
        return model_name
    # Try slug mapping (case-insensitive)
    for slug, alias in MODEL_SLUGS.items():
        if model_name.lower() == slug:
            return alias
    return model_name  # Return as-is if not found


def normalize_message_order(messages):
    """
    Reorder messages so system/developer content comes first, before any user messages.
    This is required because llama.cpp rejects system messages after user content.
    """
    if not messages:
        return messages

    system = []
    developer = []
    others = []

    for msg in messages:
        role = msg.get("role", "").lower()
        content_type = msg.get("content", {}).get("type", "text") if isinstance(msg.get("content"), dict) else "text"

        if role == "system":
            system.append(msg)
        elif role == "developer":
            developer.append(msg)
        else:
            others.append(msg)

    # Return in order: system, developer, then everything else (preserving internal order)
    return system + developer + others


def send_file(path):
    """Read and return file contents."""
    with open(path, 'rb') as f:
        return f.read()


class ProxyHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        path = self.path.split('?')[0]

        if path == "/" or path == "/index.html":
            # Serve docs
            try:
                content = send_file(os.path.join(DOCS_PATH, "index.html"))
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.send_header("Content-Length", len(content))
                self.end_headers()
                self.wfile.write(content)
            except FileNotFoundError:
                self.send_error(404)
            return

        if path == "/models" or path == "/v1/models":
            # Codex-compatible response with slug and metadata
            models = []
            for alias, info in MODEL_ALIASES.items():
                models.append({
                    "id": alias,
                    "slug": info["slug"],
                    "object": "model",
                    "owned_by": "local",
                    "permission": [],
                    "display_name": info["display_name"],
                    "description": info["description"],
                })
            response = json.dumps({"object": "list", "models": models}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", len(response))
            self.end_headers()
            self.wfile.write(response)
            return

        if path.rstrip("/") == "/model":
            info = MODEL_ALIASES.get(current_model, {})
            response = {
                "id": current_model,
                "slug": info.get("slug", ""),
                "object": "model",
                "owned_by": "local",
                "permission": [],
                "path": info.get("path", ""),
                "display_name": info.get("display_name", ""),
                "description": info.get("description", ""),
                "available": list(MODEL_ALIASES.keys())
            }
            content = json.dumps(response).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", len(content))
            self.end_headers()
            self.wfile.write(content)
            return

        # Proxy to llama-server
        self.proxy_request("GET")

    def do_POST(self):
        path = self.path.split('?')[0]

        if path == "/model" or path.rstrip("/") == "/model":
            content_length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(content_length).decode()
            try:
                data = json.loads(body)
                alias = data.get("model") or data.get("id") or data.get("alias")
                if not alias:
                    self.send_error(400, "model, id, or alias required")
                    return

                with model_lock:
                    success, msg = switch_model(alias)
                    if success:
                        info = MODEL_ALIASES.get(alias, {})
                        response = json.dumps({
                            "id": alias,
                            "object": "model",
                            "owned_by": "local",
                            "path": info.get("path", ""),
                        }).encode()
                        self.send_response(200)
                        self.send_header("Content-Type", "application/json")
                        self.send_header("Content-Length", len(response))
                        self.end_headers()
                        self.wfile.write(response)
                    else:
                        self.send_error(400, msg)
            except Exception as e:
                self.send_error(400, str(e))
            return

        if path == "/v1/responses":
            # Convert Codex Responses API to llama-server format
            content_length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(content_length).decode()
            try:
                data = json.loads(body)

                # Codex sends "messages" array, llama-server expects "input" array of objects
                if "messages" in data:
                    data["input"] = normalize_message_order(data["messages"])
                    del data["messages"]

                # Resolve model name
                if "model" in data:
                    data["model"] = resolve_model(data["model"])

                body = json.dumps(data).encode()
                self.proxy_request_with_body("POST", path, body)
            except Exception as e:
                self.send_error(400, str(e))
            return

        # Proxy to llama-server
        self.proxy_request("POST")

    def proxy_request(self, method):
        """Forward request to llama-server."""
        import urllib.request
        import urllib.error

        url = f"http://{LLAMA_HOST}:{LLAMA_PORT}{self.path}"

        headers = {}
        for k, v in self.headers.items():
            if k.lower() not in ("host", "connection", "content-length"):
                headers[k] = v

        content_length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_length) if content_length else None

        try:
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            resp = urllib.request.urlopen(req, timeout=300)

            self.send_response(resp.status)
            for k, v in resp.headers.items():
                if k.lower() not in ("transfer-encoding", "connection"):
                    self.send_header(k, v)
            self.end_headers()
            self.wfile.write(resp.read())
        except urllib.error.URLError as e:
            self.send_error(502, str(e))

    def proxy_request_with_body(self, method, path, body):
        """Forward request to llama-server with pre-serialized body."""
        import urllib.request
        import urllib.error

        url = f"http://{LLAMA_HOST}:{LLAMA_PORT}{path}"

        headers = {}
        for k, v in self.headers.items():
            if k.lower() not in ("host", "connection", "content-length"):
                headers[k] = v

        try:
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            resp = urllib.request.urlopen(req, timeout=300)

            self.send_response(resp.status)
            for k, v in resp.headers.items():
                if k.lower() not in ("transfer-encoding", "connection"):
                    self.send_header(k, v)
            self.end_headers()
            self.wfile.write(resp.read())
        except urllib.error.URLError as e:
            self.send_error(502, str(e))


def main():
    start_llama_server(MODEL_ALIASES[current_model]["path"])

    server = HTTPServer(("0.0.0.0", PROXY_PORT), ProxyHandler)
    print(f"Proxy running on port {PROXY_PORT}")
    print(f"  /           - API docs")
    print(f"  /models     - List models")
    print(f"  /model      - Get current model")
    print(f"  /completion - Inference API")
    sys.stdout.flush()
    server.serve_forever()


if __name__ == "__main__":
    main()
