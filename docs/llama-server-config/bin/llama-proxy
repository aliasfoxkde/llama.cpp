#!/usr/bin/env python3
"""
llama-proxy: Reverse proxy for llama-server with model switching support.
- Serves static docs at /
- Model endpoints: /models, /model
- Proxies all other requests to llama-server on 8080
"""

import subprocess
import json
import sys
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
import threading
import time
import os

LLAMA_HOST = "localhost"
LLAMA_PORT = 8080
PROXY_PORT = 8082
DOCS_PATH = "/home/mkinney/.llama-server/docs"

MODEL_ALIASES = {
    "Ultra": {
        "path": "/home/mkinney/Models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-IQ3_XXS.gguf",
        "slug": "ultra",
        "display_name": "Qwen3.8-27B Ultra",
        "description": "Qwen3 8B Instruct model, IQ3_XXS quantization",
    },
    "Turbo": {
        "path": "/home/mkinney/Models/JZC973/Qwen3.6-35B-REAP-MTP-UD-GGUF-Collection/Qwen3.6-35B-A3B-UD-Q3_K_M-REAP.gguf",
        "slug": "turbo",
        "display_name": "Qwen3.6-35B Turbo",
        "description": "Qwen3 35B REAP-MTP model, Q3_K_M quantization",
    },
    "Lite": {
        "path": "/home/mkinney/Models/empero-ai/Qwen3.8-2B-Q4_K_M.gguf",
        "slug": "lite",
        "display_name": "Qwen3.8-27B Lite",
        "description": "Same as Ultra, configured for lower resource usage",
    },
}

# Map Codex model names to internal aliases
MODEL_SLUGS = {
    "ultra": "Ultra",
    "turbo": "Turbo",
    "lite": "Lite",
    "qwen3.8-27b": "Ultra",
    "qwen3.6-35b": "Turbo",
}

current_model = os.environ.get("CURRENT_MODEL", "Ultra")
model_lock = threading.Lock()
server_process = None


def start_llama_server(model_path, force_restart=False):
    """Start or restart llama-server with the given model."""
    global server_process

    # Check if llama-server is already running on our port
    import urllib.request
    try:
        urllib.request.urlopen(f"http://{LLAMA_HOST}:{LLAMA_PORT}/health", timeout=1)
        if not force_restart:
            print(f"llama-server already running on port {LLAMA_PORT}")
            return True
        print(f"Restarting llama-server for {model_path}")
    except:
        pass

    # Not running, start it
    # Match only the llama-server executable; -f would also match this proxy's
    # own path because it contains the directory name "llama-server-config".
    subprocess.run(["pkill", "-x", "llama-server"], stderr=subprocess.DEVNULL)
    time.sleep(2)

    cmd = [
        "/home/mkinney/Repos/llama.cpp/build-cuda-new/bin/llama-server",
        "-m", model_path,
        "-c", "131072",
        "-tb", "256",
        "-ctk", "q4_0",
        "-ctv", "q4_0",
        "-ngl", "99",
        "-t", "16",
        "-np", "4",
        "-fa", "on",
        "--sleep-idle-seconds", "300",
        "--host", "0.0.0.0",
        "--port", str(LLAMA_PORT),
    ]

    server_process = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    import urllib.request
    for _ in range(60):
        try:
            urllib.request.urlopen(f"http://{LLAMA_HOST}:{LLAMA_PORT}/health", timeout=1)
            return True
        except:
            time.sleep(0.5)
    return False


def switch_model(alias):
    """Switch to a different model."""
    global current_model

    if alias not in MODEL_ALIASES:
        return False, f"Unknown model: {alias}. Available: {', '.join(MODEL_ALIASES.keys())}"

    model_info = MODEL_ALIASES[alias]
    model_path = model_info["path"]
    if not os.path.exists(model_path):
        return False, f"Model file not found: {model_path}"

    success = start_llama_server(model_path, force_restart=(alias != current_model))
    if success:
        current_model = alias
        return True, f"Switched to {alias}"
    return False, "Failed to start server"


def resolve_model(model_name):
    """Resolve a model name (Ultra/Turbo/Lite or slug) to internal alias."""
    if model_name in MODEL_ALIASES:
        return model_name
    # Try slug mapping (case-insensitive)
    for slug, alias in MODEL_SLUGS.items():
        if model_name.lower() == slug:
            return alias
    return model_name  # Return as-is if not found


def normalize_message_order(messages):
    """
    Reorder messages so system/developer content comes first, before any user messages.
    This is required because llama.cpp rejects system messages after user content.
    """
    if not messages:
        return messages

    system = []
    developer = []
    others = []

    for msg in messages:
        role = msg.get("role", "").lower()
        content_type = msg.get("content", {}).get("type", "text") if isinstance(msg.get("content"), dict) else "text"

        if role == "system":
            system.append(msg)
        elif role == "developer":
            developer.append(msg)
        else:
            others.append(msg)

    # Return in order: system, developer, then everything else (preserving internal order)
    return system + developer + others


def responses_input_to_messages(input_value):
    """Convert Responses API input into Chat Completions messages."""
    if isinstance(input_value, str):
        return [{"role": "user", "content": input_value}]
    if not isinstance(input_value, list):
        return []
    messages = []
    for item in input_value:
        if not isinstance(item, dict):
            continue
        if item.get("type") == "message":
            content = item.get("content", "")
            if isinstance(content, list):
                content = "".join(
                    part.get("text", "") for part in content
                    if isinstance(part, dict) and part.get("type") in ("input_text", "text")
                )
            messages.append({"role": item.get("role", "user"), "content": content})
        elif item.get("role") in ("system", "developer", "user", "assistant"):
            messages.append({"role": item["role"], "content": item.get("content", "")})
    return messages


def send_file(path):
    """Read and return file contents."""
    with open(path, 'rb') as f:
        return f.read()


class ProxyHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        path = self.path.split('?')[0]

        if path == "/health" or path == "/v1/health":
            content = json.dumps({"status": "ok", "backend": "llama.cpp", "model": current_model}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", len(content))
            self.end_headers()
            self.wfile.write(content)
            return

        if path == "/" or path == "/index.html":
            # Serve docs
            try:
                content = send_file(os.path.join(DOCS_PATH, "index.html"))
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.send_header("Content-Length", len(content))
                self.end_headers()
                self.wfile.write(content)
            except FileNotFoundError:
                self.send_error(404)
            return

        if path == "/models" or path == "/v1/models":
            # Codex-compatible response with slug and metadata
            models = []
            for alias, info in MODEL_ALIASES.items():
                models.append({
                    "id": alias,
                    "slug": info["slug"],
                    "object": "model",
                    "owned_by": "local",
                    "permission": [],
                    "display_name": info["display_name"],
                    "description": info["description"],
                    "supported_reasoning_levels": [
                        {"effort": "low", "description": "Fast reasoning"},
                        {"effort": "medium", "description": "Balanced reasoning"},
                        {"effort": "high", "description": "Deep reasoning"}
                    ],
                    "context_window": 131072,
                    "default_reasoning_level": {"effort": "medium"},
                    "input_modalities": ["text"],
                    "supports_parallel_tool_calls": False,
                    "supports_reasoning_summaries": False,
                })
            response = json.dumps({"object": "list", "models": models}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", len(response))
            self.end_headers()
            self.wfile.write(response)
            return

        if path.rstrip("/") == "/model":
            info = MODEL_ALIASES.get(current_model, {})
            response = {
                "id": current_model,
                "slug": info.get("slug", ""),
                "object": "model",
                "owned_by": "local",
                "permission": [],
                "path": info.get("path", ""),
                "display_name": info.get("display_name", ""),
                "description": info.get("description", ""),
                "available": list(MODEL_ALIASES.keys())
            }
            content = json.dumps(response).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", len(content))
            self.end_headers()
            self.wfile.write(content)
            return

        # Proxy to llama-server
        self.proxy_request("GET")

    def do_POST(self):
        path = self.path.split('?')[0]

        if path == "/model" or path.rstrip("/") == "/model":
            content_length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(content_length).decode()
            try:
                data = json.loads(body)
                alias = data.get("model") or data.get("id") or data.get("alias")
                if not alias:
                    self.send_error(400, "model, id, or alias required")
                    return

                with model_lock:
                    success, msg = switch_model(alias)
                    if success:
                        info = MODEL_ALIASES.get(alias, {})
                        response = json.dumps({
                            "id": alias,
                            "object": "model",
                            "owned_by": "local",
                            "path": info.get("path", ""),
                        }).encode()
                        self.send_response(200)
                        self.send_header("Content-Type", "application/json")
                        self.send_header("Content-Length", len(response))
                        self.end_headers()
                        self.wfile.write(response)
                    else:
                        self.send_error(400, msg)
            except Exception as e:
                self.send_error(400, str(e))
            return

        if path == "/v1/responses":
            # Convert Codex Responses API to llama-server format
            content_length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(content_length).decode()
            try:
                data = json.loads(body)

                # Log the incoming request for debugging
                print(f"[DEBUG] /v1/responses request: {body[:1000]}")

                # Check streaming - must be handled specially
                is_streaming = data.get("stream", False)
                print(f"[DEBUG] Streaming: {is_streaming}")

                # Preserve instructions and convert to system message
                instructions = data.pop("instructions", None)
                print(f"[DEBUG] Instructions: {instructions[:100] if instructions else 'None'}...")

                # Strip unsupported fields
                data.pop("reasoning", None)
                data.pop("include", None)
                data.pop("store", None)
                data.pop("tools", None)
                data.pop("reasoning_effort", None)

                if is_streaming:
                    # Use chat completions streaming with Responses SSE transform
                    messages = data.pop("messages", None)
                    if messages is None:
                        messages = responses_input_to_messages(data.pop("input", ""))
                    model = resolve_model(data.pop("model", "Ultra"))
                    temperature = data.pop("temperature", None)
                    max_tokens = data.pop("max_tokens", data.pop("max_output_tokens", None))

                    # Build chat completion request with stream: true
                    chat_data = {
                        "model": model,
                        "messages": messages,
                        "stream": True
                    }
                    if temperature is not None:
                        chat_data["temperature"] = temperature
                    if max_tokens is not None:
                        chat_data["max_tokens"] = max_tokens
                    if instructions:
                        chat_data["messages"] = [{"role": "system", "content": instructions}] + messages

                    # Normalize message order
                    chat_data["messages"] = normalize_message_order(chat_data["messages"])

                    print(f"[DEBUG] Forwarding to /v1/chat/completions stream: {json.dumps(chat_data)[:200]}")
                    self.proxy_streaming_responses_fixed("POST", "/v1/chat/completions", json.dumps(chat_data).encode())
                    return

                # Non-streaming: Codex sends "messages" array, llama-server expects "input" array
                if "messages" in data:
                    messages = data.pop("messages")
                    # Prepend instructions as system message
                    if instructions:
                        messages = [{"role": "system", "content": instructions}] + messages
                    # Normalize message order
                    messages = normalize_message_order(messages)
                    data["input"] = messages

                # Resolve model name
                if "model" in data:
                    data["model"] = resolve_model(data["model"])

                body = json.dumps(data).encode()

                # Forward to llama-server
                self.proxy_request_with_body_debug("POST", path, body)
            except Exception as e:
                import traceback
                print(f"[ERROR] /v1/responses: {e}")
                print(f"[ERROR] Trace: {traceback.format_exc()}")
                self.send_error(400, str(e))
            return

        # Proxy to llama-server
        self.proxy_request("POST")

    def proxy_request(self, method):
        """Forward request to llama-server."""
        import urllib.request
        import urllib.error

        url = f"http://{LLAMA_HOST}:{LLAMA_PORT}{self.path}"

        headers = {}
        for k, v in self.headers.items():
            if k.lower() not in ("host", "connection", "content-length"):
                headers[k] = v

        content_length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_length) if content_length else None

        try:
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            resp = urllib.request.urlopen(req, timeout=300)

            self.send_response(resp.status)
            for k, v in resp.headers.items():
                if k.lower() not in ("transfer-encoding", "connection"):
                    self.send_header(k, v)
            self.end_headers()
            self.wfile.write(resp.read())
        except urllib.error.URLError as e:
            self.send_error(502, str(e))

    def proxy_request_with_body(self, method, path, body):
        """Forward request to llama-server with pre-serialized body."""
        import urllib.request
        import urllib.error

        url = f"http://{LLAMA_HOST}:{LLAMA_PORT}{path}"

        headers = {}
        for k, v in self.headers.items():
            if k.lower() not in ("host", "connection", "content-length"):
                headers[k] = v

        try:
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            resp = urllib.request.urlopen(req, timeout=300)

            self.send_response(resp.status)
            for k, v in resp.headers.items():
                if k.lower() not in ("transfer-encoding", "connection"):
                    self.send_header(k, v)
            self.end_headers()
            self.wfile.write(resp.read())
        except urllib.error.URLError as e:
            self.send_error(502, str(e))

    def proxy_request_with_body_debug(self, method, path, body):
        """Forward request to llama-server with better error logging."""
        import urllib.request
        import urllib.error

        url = f"http://{LLAMA_HOST}:{LLAMA_PORT}{path}"

        headers = {}
        for k, v in self.headers.items():
            if k.lower() not in ("host", "connection", "content-length"):
                headers[k] = v

        req = urllib.request.Request(url, data=body, headers=headers, method=method)
        try:
            resp = urllib.request.urlopen(req, timeout=300)
            self.send_response(resp.status)
            for k, v in resp.headers.items():
                if k.lower() not in ("transfer-encoding", "connection"):
                    self.send_header(k, v)
            self.end_headers()
            self.wfile.write(resp.read())
        except urllib.error.HTTPError as e:
            error_body = e.read().decode()
            print(f"[DEBUG] Upstream HTTP {e.code}: {error_body[:500]}")
            self.send_error(502, f"Upstream error: {error_body[:200]}")
        except urllib.error.URLError as e:
            self.send_error(502, str(e))

    def proxy_streaming_responses(self, method, path, body):
        """Forward streaming request and transform Chat Completions SSE to Responses SSE."""
        import urllib.request
        import urllib.error

        url = f"http://{LLAMA_HOST}:{LLAMA_PORT}{path}"

        headers = {}
        for k, v in self.headers.items():
            if k.lower() not in ("host", "connection", "content-length"):
                headers[k] = v
        headers["Accept"] = "text/event-stream"

        print(f"[DEBUG] Opening streaming request to {url}")
        try:
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            resp = urllib.request.urlopen(req, timeout=300)

            print(f"[DEBUG] Streaming response status: {resp.status}")
            self.send_response(resp.status)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")
            self.end_headers()

            # Stream and transform Chat Completions SSE to Responses SSE
            buffer = ""
            response_id = f"resp_{os.urandom(8).hex()}"
            output_id = f"msg_{os.urandom(8).hex()}"
            text_buffer = []

            while True:
                chunk = resp.read(1)
                if not chunk:
                    break

                char = chunk.decode('utf-8', errors='replace')
                if char == '\n':
                    line = buffer.strip()
                    buffer = ""

                    if line.startswith("data: "):
                        data_str = line[6:].strip()
                        if data_str == "[DONE]":
                            # Send final completion event
                            final_text = "".join(text_buffer)
                            if final_text:
                                event = f"event: response.output_text.delta\ndata: {{\"delta\": \"{final_text}\"}}\n\n"
                                self.wfile.write(event.encode('utf-8'))
                            self.wfile.write(b"event: response.completed\ndata: {}\n\n")
                            self.wfile.flush()
                            print(f"[DEBUG] Streaming completed")
                        else:
                            try:
                                chunk_data = json.loads(data_str)
                                # Transform Chat Completions chunk to Responses delta
                                if "choices" in chunk_data:
                                    choice = chunk_data["choices"][0]
                                    if "delta" in choice:
                                        delta = choice["delta"]
                                        if "content" in delta:
                                            text = delta["content"]
                                            text_buffer.append(text)
                                            event = f"event: response.output_text.delta\ndata: {{\"delta\": {json.dumps(text)}}}\n\n"
                                            self.wfile.write(event.encode('utf-8'))
                                            self.wfile.flush()
                            except json.JSONDecodeError:
                                pass
                else:
                    buffer += char

        except urllib.error.HTTPError as e:
            error_body = e.read().decode()
            print(f"[DEBUG] Streaming HTTP {e.code}: {error_body[:500]}")
            self.send_error(502, f"Upstream streaming error: {error_body[:200]}")
        except Exception as e:
            import traceback
            print(f"[DEBUG] Streaming error: {e}")
            print(f"[DEBUG] Trace: {traceback.format_exc()}")
            self.send_error(502, str(e))


    def proxy_streaming_responses_fixed(self, method, path, body):
        """Stream Chat Completions and emit a valid Responses SSE stream."""
        import urllib.request
        import urllib.error

        url = f"http://{LLAMA_HOST}:{LLAMA_PORT}{path}"
        headers = {
            k: v for k, v in self.headers.items()
            if k.lower() not in ("host", "connection", "content-length")
        }
        headers["Accept"] = "text/event-stream"
        try:
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            resp = urllib.request.urlopen(req, timeout=300)
            print(f"[DEBUG] Streaming response status: {resp.status}")
            self.send_response(resp.status)
            self.send_header("Content-Type", "text/event-stream; charset=utf-8")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")
            self.end_headers()

            response_id = f"resp_{os.urandom(8).hex()}"
            created = {"type": "response.created", "response": {
                "id": response_id, "object": "response", "status": "in_progress"
            }}
            self.wfile.write((f"event: response.created\ndata: {json.dumps(created)}\n\n").encode())
            item_id = f"msg_{os.urandom(8).hex()}"
            item = {"type": "response.output_item.added", "output_index": 0, "item": {
                "id": item_id, "type": "message", "status": "in_progress",
                "role": "assistant", "content": []
            }}
            self.wfile.write((f"event: response.output_item.added\ndata: {json.dumps(item)}\n\n").encode())
            part = {"type": "response.content_part.added", "item_id": item_id,
                    "output_index": 0, "content_index": 0,
                    "part": {"type": "output_text", "text": "", "annotations": []}}
            self.wfile.write((f"event: response.content_part.added\ndata: {json.dumps(part)}\n\n").encode())
            self.wfile.flush()
            completed = False
            full_text = []

            # Read complete byte lines to preserve multibyte UTF-8 characters.
            for raw_line in iter(resp.readline, b""):
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if payload == "[DONE]":
                    completed = True
                    break
                try:
                    chunk = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                choices = chunk.get("choices") or []
                if not choices:
                    continue
                text = (choices[0].get("delta") or {}).get("content")
                if not isinstance(text, str) or not text:
                    continue
                full_text.append(text)
                event = {"type": "response.output_text.delta", "item_id": item_id,
                         "output_index": 0, "content_index": 0, "delta": text,
                         "logprobs": []}
                self.wfile.write((f"event: response.output_text.delta\ndata: {json.dumps(event, ensure_ascii=False)}\n\n").encode("utf-8"))
                self.wfile.flush()

            for event_name, event in [
                ("response.output_text.done", {"type": "response.output_text.done", "item_id": item_id, "output_index": 0, "content_index": 0, "text": "".join(full_text)}),
                ("response.content_part.done", {"type": "response.content_part.done", "item_id": item_id, "output_index": 0, "content_index": 0, "part": {"type": "output_text", "text": "".join(full_text), "annotations": []}}),
                ("response.output_item.done", {"type": "response.output_item.done", "output_index": 0, "item": {"id": item_id, "type": "message", "status": "completed", "role": "assistant", "content": [{"type": "output_text", "text": "".join(full_text), "annotations": []}]}}),
            ]:
                self.wfile.write((f"event: {event_name}\ndata: {json.dumps(event)}\n\n").encode())
            final = {"type": "response.completed", "response": {
                "id": response_id, "object": "response", "status": "completed"
            }}
            self.wfile.write((f"event: response.completed\ndata: {json.dumps(final)}\n\n").encode())
            self.wfile.flush()
            resp.close()
            self.close_connection = True
            print(f"[DEBUG] Streaming completed (upstream_done={completed})")
        except urllib.error.HTTPError as e:
            error_body = e.read().decode("utf-8", errors="replace")
            print(f"[DEBUG] Streaming HTTP {e.code}: {error_body[:1000]}")
            if not self.wfile.closed:
                self.send_error(502, f"Upstream streaming error: {error_body[:200]}")
        except Exception as e:
            import traceback
            print(f"[DEBUG] Streaming error: {e}")
            print(f"[DEBUG] Trace: {traceback.format_exc()}")


def main():
    start_llama_server(MODEL_ALIASES[current_model]["path"])

    server = ThreadingHTTPServer(("0.0.0.0", PROXY_PORT), ProxyHandler)
    print(f"Proxy running on port {PROXY_PORT}")
    print(f"  /           - API docs")
    print(f"  /models     - List models")
    print(f"  /model      - Get current model")
    print(f"  /completion - Inference API")
    sys.stdout.flush()
    server.serve_forever()


if __name__ == "__main__":
    main()
